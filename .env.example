# Copy to .env and fill in real local values. Never commit .env.

# PostgreSQL Container Environment
POSTGRES_USER=lms_owner
POSTGRES_PASSWORD=lms_dev_password
POSTGRES_DB=lms_dev

# Restricted application role (cannot bypass RLS, not the table owner)
DATABASE_URL="postgresql://lms_app:CHANGE_ME@localhost:5432/lms_dev?schema=public"

# Privileged role used only for migrations and seed
MIGRATION_DATABASE_URL="postgresql://lms_migrator:CHANGE_ME@localhost:5432/lms_dev?schema=public"

# Default password for fictional local seed users
SEED_DEFAULT_PASSWORD="CHANGE_ME"

# Random secret for the auth library (generate a long random value)
AUTH_SECRET="CHANGE_ME"

APP_URL="http://localhost:3000"
